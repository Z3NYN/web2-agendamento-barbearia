# Porta exposta no host pelo frontend Nginx (com proxy /api para o backend)
APP_PORT=8080

# Modo de execução:
# true  -> carrega dados e contas ilustrativas na primeira inicialização (demonstração/avaliação)
# false -> instalação limpa de produção (exige SOLDADO_ADMIN_PASSWORD e SOLDADO_JWT_SECRET)
SOLDADO_DEMO=true

# Obrigatórios quando SOLDADO_DEMO=false (nunca versionar valores reais no GitHub)
SOLDADO_ADMIN_PASSWORD=
SOLDADO_JWT_SECRET=
SOLDADO_JWT_TTL=28800000

# Credenciais opcionais do banco H2 persistente
SOLDADO_DB_USER=sa
SOLDADO_DB_PASSWORD=

# Web Push / VAPID (quando vazias, as chaves são geradas e persistidas no volume em /app/dados/vapid.properties)
SOLDADO_VAPID_SUBJECT=mailto:contato@soldadodocorte.local
SOLDADO_VAPID_PUBLIC_KEY=
SOLDADO_VAPID_PRIVATE_KEY=
